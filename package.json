{
  "name": "dsh-preset-scope",
  "version": "0.1.0",
  "private": true,
  "description": "Preset and scope toolkit for DeepSeek Harness: switch the agent preset of a live session, and scope Skills/MCP capabilities per workspace, session, or globally.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "preset",
    "workspace",
    "skills",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/preset.js",
    "lib/scope.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/manifest.test.js test/composition.test.js test/preset-routes.test.js test/scope-routes.test.js test/client-slots.test.js",
    "merge:client": "node tools/merge-client.mjs"
  }
}
