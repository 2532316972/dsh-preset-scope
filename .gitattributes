# Repo-wide default: keep the bytes we committed.
* text=auto

# lib/client.js is a build artifact regenerated by tools/merge-client.mjs and
# checked with --check. A CRLF/LF flip would make every `--check` fail on a
# clean clone, so the line ending is pinned rather than converted.
lib/client.js text eol=lf
vendor/*.js   text eol=lf
tools/*.mjs   text eol=lf
lib/*.js      text eol=lf

# Binary-ish assets
*.svg text eol=lf
*.png binary
